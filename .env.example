# All four are PUBLIC values (this site is an OIDC public client: PKCE, no secret).
# Copy from the SSO Platforms console → Integration, and the docs at <console>/docs.

# OIDC issuer. Everything else (authorize/token/end-session) comes from its discovery document.
NEXT_PUBLIC_ZTOR_ISSUER=https://ztorpartners.tripcaststudio.com/sso
# The Ztor gateway origin + /api: the Creator API lives at {API}/creator/v1/*.
NEXT_PUBLIC_ZTOR_API=https://ztorapi.tripcaststudio.com/api
# Your platform's client id; also sent as X-Channel-Key on every shop call.
NEXT_PUBLIC_ZTOR_CLIENT_ID=8202d7c12f2faf180465
# RFC 8707 resource indicator of the Creator API (the SSO's SSO_CREATOR_API_RESOURCE, same literal).
# Sent on the authorize + token requests so the access token works on the shop endpoints.
# Leave empty only while the SSO has none configured: sign-in still works, cart/checkout/orders answer 401.
NEXT_PUBLIC_ZTOR_SHOP_RESOURCE=https://ztorapi.tripcaststudio.com/api/creator
# Optional: Shopping's media CDN (product images arrive as paths relative to it). Unset = the default below.
# NEXT_PUBLIC_ZTOR_MEDIA=https://d1k50uq0sig7az.cloudfront.net
